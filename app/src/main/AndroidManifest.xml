<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Modern libxposed modules are declared entirely through META-INF/xposed
        (module.prop, scope.list, java_init.list). The manifest only carries the
        module name/description the loader surfaces in the manager UI.
    -->
    <application
        android:label="@string/app_name"
        android:description="@string/module_description" />

</manifest>
